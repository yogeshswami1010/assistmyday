NEXT_PUBLIC_SITE_URL=https://assistmyday.com

# Hostinger MySQL — enter real values only in Hostinger environment variables
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=your_database_name

# Admin login — use unique production secrets in Hostinger environment variables
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=use-at-least-8-characters
# Optional: keeps sessions valid across restarts; use 32+ random characters
ADMIN_AUTH_SECRET=optional-32-character-stable-session-secret
