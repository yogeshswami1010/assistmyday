{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "dev:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "gsap": "^3.15.0",
    "mysql2": "^3.24.6",
    "next": "16.4.3",
    "nodemailer": "^10.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "^2.18.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vinext": "1.3.1",
    "vite": "8.3.5",
    "wrangler": "4.154.0"
  },
  "type": "module"
  ,"overrides": {
    "undici": "7.30.1",
    "zod": "4.6.6",
    "brace-expansion": "5.0.12",
    "browserslist": "4.28.7",
    "baseline-browser-mapping": "2.11.0",
    "fflate": "0.7.5",
    "esbuild": "0.28.2",
    "@babel/core": "7.29.6",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.21"
    }
  }
}
